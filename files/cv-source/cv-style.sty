% Shared style for the Spanish and English CVs (compile with pdflatex).
% cv-es.tex -> CV_Esteban_Hernandez_Urrutia.pdf
% cv-en.tex -> CV_Esteban_Hernandez_Urrutia_EN.pdf
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}[2026/11/19 CV style]

\RequirePackage[letterpaper, left=0.75in, right=0.75in, top=0.7in, bottom=0.75in, footskip=0.45in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sfdefault,book,lf]{FiraSans}
\RequirePackage{fontawesome5}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{xurl}
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.05}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

\definecolor{cvgray}{HTML}{3A3A3A}

% Footer: \cvfooter{date}{center text}
\newcommand{\cvfooter}[2]{%
  \fancyfoot[L]{\footnotesize\scshape #1}%
  \fancyfoot[C]{\footnotesize\scshape #2}%
  \fancyfoot[R]{\footnotesize\thepage}}

% Header: \cvheader{First}{Last}{position}{email}{website}
\newcommand{\cvheader}[5]{%
  \begin{center}
    {\fontsize{28pt}{30pt}\selectfont\fontseries{l}\selectfont #1 \textbf{#2}}\\[8pt]
    {\small\scshape #3}\\[6pt]
    {\small\faEnvelope\ \href{mailto:#4}{#4}\quad\textbar\quad\faHome\ \href{https://#5}{#5}}
  \end{center}
  \vspace{4pt}}

% Section title followed by a rule
\newcommand{\cvsection}[1]{%
  \par\needspace{5\baselineskip}\vspace{10pt}%
  {\large #1}\ \leaders\hrule height 0.6pt\hfill\kern0pt\par
  \vspace{6pt}}

\newcommand{\cvsubsection}[1]{{\small\scshape #1}\par\vspace{2pt}}

% Degree entry: \cventry{institution}{place}{degree}{years}{items}
\newcommand{\cventry}[5]{%
  \textbf{#1}\hfill\textit{#2}\par
  {\scshape #3}\hfill\textit{#4}\par
  \begin{itemize}[leftmargin=10pt, label=\textbullet, itemsep=0pt, topsep=1pt]
    #5
  \end{itemize}
  \vspace{6pt}}

% Dated row: \cvrow{date}{description}{place}
\newcommand{\cvrow}[3]{%
  \noindent\begin{tabularx}{\linewidth}{@{}p{1.55in}X>{\raggedleft\arraybackslash}p{1.35in}@{}}
    #1 & #2 & \textit{#3}
  \end{tabularx}\par\vspace{1pt}}

% Dated row without place column: \cvitem{date}{description}
\newcommand{\cvitem}[2]{%
  \noindent\begin{tabularx}{\linewidth}{@{}p{1.55in}X@{}}
    #1 & #2
  \end{tabularx}\par\vspace{1pt}}

% Hanging-indent paragraph for references and talks
\newcommand{\cvref}[1]{%
  {\hangindent=1.6em\hangafter=1 #1\par}\vspace{5pt}}
